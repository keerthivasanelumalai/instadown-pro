# ─── InstaDown Pro — Backend Environment Variables ───────────────────────────
# Copy this to backend/.env and fill in your real values.
# NEVER commit .env to Git — it is already in .gitignore.

NODE_ENV=development
PORT=3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# For local dev: http://localhost:3000
# For production: your actual frontend domain
FRONTEND_ORIGIN=http://localhost:3000

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated list of Google account emails allowed to hit /api/admin/users
ADMIN_EMAILS=your@email.com
